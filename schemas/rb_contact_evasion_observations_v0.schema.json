{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiber-data.local/schemas/rb_contact_evasion_observations_v0.schema.json",
  "title": "rb_contact_evasion_observations_v0 (contract, no artifact)",
  "description": "Shape gate for the RB contact-evasion source-observation contract (TIBER-Data #234, Slice A). This is a CONTRACT ONLY: no builder, no candidate or promoted artifact, and no admitted source exists under it. One row is one canonical player x one exact football window x one metric definition x one source snapshot x one denominator definition. SEMANTIC AUTHORITY LIVES IN src/contracts/v1/rbContactEvasionObservationsV0.ts, NOT IN THE PAYLOAD: the code-owned metric dictionary fixes each metric's mechanism, admissible opportunity classes, value kind, unit, directionality, numeric domain, canonical inclusion rules, required caveat identities, and rate composition; the code-owned minimum-sample rule fixes the governing threshold; clock origins, acquisition modes, and rights dispositions are closed vocabularies whose combinations are cross-checked. A row restates some of those facts for inspectability and is rejected when it disagrees. The schema is a SHAPE gate: closed vocabularies, all seven clocks with declared origins, and unknown-field rejection. Cross-field contract rules (descriptor agreement, canonical-definition identity, rate arithmetic and component identity, eligible-opportunity/denominator equality, numeric domains, definition drift, clock substitution/availability/total ordering, window-scope coherence, acquisition-permission compatibility, retention of stored values, attribution obligations, digest format, cohort scope, mechanism/metric binding, artifact-level identity and grain uniqueness, transform lineage, fixture-provenance and promoted-position fail-closed rules) are enforced by the contract layer and are NOT expressible here. There is deliberately no score, composite, grade, ranking, percentile, tier, rating, neutral default, fantasy field, or 'elite' judgment anywhere in this schema, and none may be added.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "schema_version",
    "artifact_position",
    "generated_at",
    "contract_ref",
    "observations"
  ],
