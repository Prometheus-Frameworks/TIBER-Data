{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiber-data.local/schemas/rb_contact_evasion_observations_v0.schema.json",
  "title": "rb_contact_evasion_observations_v0 (contract, no artifact)",
  "description": "Shape gate for the RB contact-evasion source-observation contract (TIBER-Data #234, Slice A). This is a CONTRACT ONLY: no builder, no candidate or promoted artifact, and no admitted source exists under it. One row is one canonical player x one exact football window x one metric definition x one source snapshot x one denominator definition. The schema is a SHAPE gate: closed vocabularies, required clocks, and unknown-field rejection. Cross-field contract rules (rate denominators, definition drift, clock substitution, cohort scope, mechanism/metric binding, incompatible transform inputs, fixture-provenance position) are enforced by src/contracts/v1/rbContactEvasionObservationsV0.ts and are NOT expressible here. There is deliberately no score, composite, grade, ranking, percentile, tier, rating, neutral default, fantasy field, or 'elite' judgment anywhere in this schema, and none may be added.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "schema_version",
    "artifact_position",
    "generated_at",
    "contract_ref",
    "observations"
  ],
  "properties": {
    "artifact_id": { "const": "rb_contact_evasion_observations_v0" },
    "schema_version": { "const": "rb_contact_evasion_observations_v0.1.0" },
    "artifact_position": { "$ref": "#/$defs/artifactPosition" },
    "generated_at": { "type": "string", "format": "date-time" },
    "contract_ref": { "type": "string", "minLength": 1 },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "isoDatetime": { "type": "string", "format": "date-time" },
    "mechanismId": {
      "description": "Closed mechanism universe. 'elusiveness' is not a member: it is a human umbrella term that decomposes into these five separately-observed mechanisms. Evidence for one never satisfies another.",
      "enum": [
        "speed",
        "agility_change_of_direction",
        "contact_avoidance",
        "contact_survival",
        "explosiveness"
      ]
    },
    "evidenceClass": {
      "enum": ["direct", "normalized", "derived", "external_opinion"]
    },
    "sourceAccessClass": {
      "enum": [
        "open_and_ingestible",
        "public_but_terms_constrained",
        "licensed_or_gated",
        "reference_only",
        "unavailable",
        "unknown"
      ]
    },
    "provenanceMode": { "enum": ["live", "snapshot", "fixture"] },
    "artifactPosition": { "enum": ["fixture_only", "candidate", "promoted"] },
    "sourceMaterialKind": {
      "enum": ["measured_observation", "derived_publication", "editorial_opinion"]
    },
    "opportunityClass": {
      "enum": ["rushing", "receiving", "combined_rushing_receiving", "athletic_testing"]
    },
    "opportunityType": {
      "enum": ["rush_attempt", "reception", "target", "touch", "contact_event", "testing_trial"]
    },
    "seasonType": { "enum": ["PRE", "REG", "POST"] },
    "windowCompleteness": {
      "enum": ["single_week", "multi_week", "partial_season", "full_season"]
    },
    "valueKind": { "enum": ["rate", "count", "duration_seconds", "speed_mph"] },
    "directionality": {
      "enum": ["higher_is_more_of_mechanism", "lower_is_more_of_mechanism"]
    },
    "measurementStatus": { "enum": ["observed", "missing"] },
    "missingnessReason": {
      "enum": [
        "rights_blocked",
        "source_unavailable",
        "below_minimum_sample",
        "not_measured",
        "definition_incompatible"
      ]
    },
    "identityResolution": { "enum": ["canonical_gsis_id", "unresolved"] },
    "position": { "enum": ["QB", "RB", "WR", "TE"] },
    "identity": {
      "description": "Canonical identity. gsis_id is nullable only so an unresolved row can be expressed and then rejected by the contract layer; a name, team, position, or provider id never authorizes identity.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gsis_id",
        "identity_resolution",
        "provider_player_id",
        "display_name_non_authoritative"
      ],
      "properties": {
        "gsis_id": { "type": ["string", "null"], "minLength": 1 },
        "identity_resolution": { "$ref": "#/$defs/identityResolution" },
        "provider_player_id": { "type": ["string", "null"], "minLength": 1 },
        "display_name_non_authoritative": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_at_window",
        "season",
        "season_type",
        "week",
        "games_included",
        "window_completeness",
        "opportunity_class"
      ],
      "properties": {
        "position_at_window": { "$ref": "#/$defs/position" },
        "season": { "type": "integer", "minimum": 1900 },
        "season_type": { "$ref": "#/$defs/seasonType" },
        "week": { "type": ["integer", "null"], "minimum": 1, "maximum": 22 },
        "games_included": { "type": "integer", "minimum": 0 },
        "window_completeness": { "$ref": "#/$defs/windowCompleteness" },
        "opportunity_class": { "$ref": "#/$defs/opportunityClass" }
      }
    },
    "clocks": {
      "description": "All seven clocks, each with its own meaning. Retrieval time never substitutes for a football window or a source-generation clock; that substitution is caught by the contract layer, not here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_start",
        "window_end",
        "source_observed_at",
        "source_generated_at",
        "source_available_at",
        "retrieved_at",
        "artifact_generated_at"
      ],
      "properties": {
        "window_start": { "$ref": "#/$defs/isoDatetime" },
        "window_end": { "$ref": "#/$defs/isoDatetime" },
        "source_observed_at": {
          "oneOf": [{ "$ref": "#/$defs/isoDatetime" }, { "type": "null" }]
        },
        "source_generated_at": { "$ref": "#/$defs/isoDatetime" },
        "source_available_at": { "$ref": "#/$defs/isoDatetime" },
        "retrieved_at": { "$ref": "#/$defs/isoDatetime" },
        "artifact_generated_at": { "$ref": "#/$defs/isoDatetime" }
      }
    },
    "combinedComponentDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rushing_component_metric_id", "receiving_component_metric_id", "disclosure"],
      "properties": {
        "rushing_component_metric_id": { "$ref": "#/$defs/nonEmptyString" },
        "receiving_component_metric_id": { "$ref": "#/$defs/nonEmptyString" },
        "disclosure": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "source_native_metric_name",
        "definition_ref",
        "definition_version",
        "unit",
        "value_kind",
        "directionality",
        "minimum_eligible_opportunities",
        "inclusion_exclusion_rules",
        "combined_component_disclosure"
      ],
      "properties": {
        "metric_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_native_metric_name": { "$ref": "#/$defs/nonEmptyString" },
        "definition_ref": { "$ref": "#/$defs/nonEmptyString" },
        "definition_version": { "$ref": "#/$defs/nonEmptyString" },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "value_kind": { "$ref": "#/$defs/valueKind" },
        "directionality": { "$ref": "#/$defs/directionality" },
        "minimum_eligible_opportunities": { "type": "integer", "minimum": 0 },
        "inclusion_exclusion_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "combined_component_disclosure": {
          "oneOf": [{ "$ref": "#/$defs/combinedComponentDisclosure" }, { "type": "null" }]
        }
      }
    },
    "numerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "value"],
      "properties": {
        "metric_id": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "type": "number" }
      }
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "value", "opportunity_type"],
      "properties": {
        "metric_id": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "type": "number" },
        "opportunity_type": { "$ref": "#/$defs/opportunityType" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missingness_reason",
        "value",
        "numerator",
        "denominator",
        "eligible_opportunities"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/measurementStatus" },
        "missingness_reason": {
          "oneOf": [{ "$ref": "#/$defs/missingnessReason" }, { "type": "null" }]
        },
        "value": { "type": ["number", "null"] },
        "numerator": { "oneOf": [{ "$ref": "#/$defs/numerator" }, { "type": "null" }] },
        "denominator": { "oneOf": [{ "$ref": "#/$defs/denominator" }, { "type": "null" }] },
        "eligible_opportunities": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "cohortScope": {
      "description": "Cohort MEMBERSHIP INPUTS only. It carries no percentile, rank, threshold, score, or grade, and none may be added: that boundary is TIBER-Ops #15 and is unresolved.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "season",
        "season_type",
        "window_completeness",
        "minimum_eligible_opportunities",
        "window_completeness_disclosure"
      ],
      "properties": {
        "position": { "$ref": "#/$defs/position" },
        "season": { "type": "integer", "minimum": 1900 },
        "season_type": { "$ref": "#/$defs/seasonType" },
        "window_completeness": { "$ref": "#/$defs/windowCompleteness" },
        "minimum_eligible_opportunities": { "type": "integer", "minimum": 0 },
        "window_completeness_disclosure": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transform_version", "input_metric_ids"],
      "properties": {
        "transform_version": { "$ref": "#/$defs/nonEmptyString" },
        "input_metric_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "product",
        "snapshot_id",
        "access_class",
        "acquisition_method",
        "material_kind",
        "supported_opportunity_types",
        "rights_review_ref",
        "promotable",
        "provenance_mode",
        "superseded_by_snapshot_id"
      ],
      "properties": {
        "owner": { "$ref": "#/$defs/nonEmptyString" },
        "product": { "$ref": "#/$defs/nonEmptyString" },
        "snapshot_id": { "$ref": "#/$defs/nonEmptyString" },
        "access_class": { "$ref": "#/$defs/sourceAccessClass" },
        "acquisition_method": { "$ref": "#/$defs/nonEmptyString" },
        "material_kind": { "$ref": "#/$defs/sourceMaterialKind" },
        "supported_opportunity_types": {
          "type": "array",
          "items": { "$ref": "#/$defs/opportunityType" }
        },
        "rights_review_ref": { "$ref": "#/$defs/nonEmptyString" },
        "promotable": { "type": "boolean" },
        "provenance_mode": { "$ref": "#/$defs/provenanceMode" },
        "superseded_by_snapshot_id": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "observation": {
      "description": "One canonical player x one exact football window x one metric definition x one source snapshot x one denominator definition.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "mechanism_id",
        "evidence_class",
        "identity",
        "scope",
        "clocks",
        "metric",
        "measurement",
        "cohort_scope",
        "transform",
        "source",
        "warnings"
      ],
      "properties": {
        "observation_id": { "$ref": "#/$defs/nonEmptyString" },
        "mechanism_id": { "$ref": "#/$defs/mechanismId" },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" },
        "identity": { "$ref": "#/$defs/identity" },
        "scope": { "$ref": "#/$defs/scope" },
        "clocks": { "$ref": "#/$defs/clocks" },
        "metric": { "$ref": "#/$defs/metric" },
        "measurement": { "$ref": "#/$defs/measurement" },
        "cohort_scope": { "oneOf": [{ "$ref": "#/$defs/cohortScope" }, { "type": "null" }] },
        "transform": { "oneOf": [{ "$ref": "#/$defs/transform" }, { "type": "null" }] },
        "source": { "$ref": "#/$defs/source" },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    }
  }
}
