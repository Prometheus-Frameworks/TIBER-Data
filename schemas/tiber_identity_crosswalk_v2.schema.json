{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.tiber.local/schemas/tiber_identity_crosswalk_v2.schema.json",
  "title": "TIBER Identity Crosswalk V2",
  "description": "V2 differs from V1 in exactly one semantic: tiber_player_id is a GSIS player id rather than a tiber-data-player-2025-* slug. The vocabulary change follows FORGE_PLAYER_STATIC_V1, which is GSIS-keyed; a crosswalk in the V1 vocabulary resolves to zero FORGE rows. Evidence-tier match_method values and their confidence mapping are also new, and team is nullable because provider rosters omit it for unsigned players.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "schema_version",
    "generated_at",
    "supported_providers",
    "coverage",
    "id_vocabulary",
    "source_artifacts",
    "record_count",
    "records"
  ],
  "properties": {
    "artifact_id": { "const": "TIBER_IDENTITY_CROSSWALK_V2" },
    "schema_version": { "const": "v2" },
    "generated_at": { "type": "string", "format": "date-time" },
    "supported_providers": {
      "type": "array",
      "items": { "const": "sleeper" },
      "minItems": 1,
      "uniqueItems": true
    },
    "coverage": {
      "const": "operator_promoted_slice_gsis_vocabulary_not_full_player_universe"
    },
    "id_vocabulary": { "const": "gsis" },
    "coverage_notes": { "type": "object" },
    "record_count_by_match_method": { "type": "object" },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "path", "sha256"],
        "properties": {
          "artifact": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "record_count": { "type": "integer", "minimum": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/crosswalkRow" }
    }
  },
  "$defs": {
    "crosswalkRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "provider_player_id",
        "provider_canonical_id",
        "tiber_player_id",
        "player_name",
        "position",
        "team",
        "confidence",
        "match_method",
        "source",
        "source_updated_at"
      ],
      "properties": {
        "provider": { "const": "sleeper" },
        "provider_player_id": { "type": "string", "minLength": 1 },
        "provider_canonical_id": {
          "type": "string",
          "pattern": "^sleeper:[^\\s:]+$"
        },
        "tiber_player_id": {
          "type": "string",
          "pattern": "^00-\\d{7}$"
        },
        "player_name": { "type": "string", "minLength": 1 },
        "position": { "enum": ["QB", "RB", "WR", "TE", "K", "DST"] },
        "team": {
          "type": ["string", "null"],
          "minLength": 2,
          "maxLength": 4
        },
        "confidence": { "enum": ["exact", "high", "medium", "provisional"] },
        "match_method": {
          "enum": ["verified_manual_seed", "gsis_direct", "espn_bridge", "name_exact"]
        },
        "source": { "type": "string", "minLength": 1 },
        "source_updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
