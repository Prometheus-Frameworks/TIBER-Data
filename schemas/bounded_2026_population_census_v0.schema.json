{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiber-data.local/schemas/bounded_2026_population_census_v0.schema.json",
  "title": "Bounded 2026 population census v0 candidate",
  "description": "Row-preserving, two-source population census candidate created under TIBER-Data #227. It is not a complete active-player universe, Forecast admission decision, ranking, or promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "schema_version",
    "status",
    "generated_at",
    "scope_id",
    "scope_definition",
    "source_artifacts",
    "population_row_count",
    "population_rows",
    "coverage_summary",
    "reconciliation",
    "limitations",
    "consumer_safety"
  ],
  "properties": {
    "artifact_id": {
      "const": "bounded_2026_population_census_v0"
    },
    "schema_version": {
      "const": "bounded_2026_population_census_v0.1.0"
    },
    "status": {
      "const": "candidate_governed_artifact_not_promoted"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope_id": {
      "const": "historical_offense_plus_2026_rookies_v0"
    },
    "scope_definition": {
      "$ref": "#/$defs/scopeDefinition"
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/sourceArtifact"
      }
    },
    "population_row_count": {
      "type": "integer",
      "minimum": 1
    },
    "population_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/populationRow"
      }
    },
    "coverage_summary": {
      "$ref": "#/$defs/coverageSummary"
    },
    "reconciliation": {
      "$ref": "#/$defs/reconciliation"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "consumer_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "not_authorized"
      ],
      "properties": {
        "allowed": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "not_authorized": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nullableNonEmptyString": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "countMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "scopeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "included_cohorts",
        "outside_scope",
        "full_universe_claim",
        "idp_full_universe_available",
        "activity_inference_performed",
        "identity_join_policy"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "included_cohorts": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "outside_scope": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "full_universe_claim": {
          "const": false
        },
        "idp_full_universe_available": {
          "const": false
        },
        "activity_inference_performed": {
          "const": false
        },
        "identity_join_policy": {
          "const": "exact_source_identity_only_no_cross_namespace_join"
        }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_artifact_key",
        "repository",
        "commit",
        "path",
        "sha256",
        "artifact_version",
        "artifact_status",
        "artifact_generated_at",
        "source_row_count",
        "included_row_count",
        "inclusion_rule",
        "governance_evidence"
      ],
      "properties": {
        "source_artifact_key": {
          "enum": [
            "tiber_data_player_season_coverage_v0_2025",
            "tiber_rookies_transition_profile_v0_2_2026"
          ]
        },
        "repository": {
          "enum": [
            "Prometheus-Frameworks/TIBER-Data",
            "Prometheus-Frameworks/TIBER-Rookies"
          ]
        },
        "commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_status": {
          "type": "string",
          "minLength": 1
        },
        "artifact_generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_row_count": {
          "type": "integer",
          "minimum": 1
        },
        "included_row_count": {
          "type": "integer",
          "minimum": 1
        },
        "inclusion_rule": {
          "type": "string",
          "minLength": 1
        },
        "governance_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "sourceIdentityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_artifact_key",
        "source_namespace",
        "source_player_id",
        "source_identity_confidence",
        "source_row_key",
        "source_row_index",
        "source_row_sha256"
      ],
      "properties": {
        "source_artifact_key": {
          "enum": [
            "tiber_data_player_season_coverage_v0_2025",
            "tiber_rookies_transition_profile_v0_2_2026"
          ]
        },
        "source_namespace": {
          "enum": [
            "tiber_data_player_id",
            "tiber_rookies_player_id"
          ]
        },
        "source_player_id": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "source_identity_confidence": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "source_row_key": {
          "type": "string",
          "minLength": 1
        },
        "source_row_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based row index in the complete, unfiltered pinned source artifact array."
        },
        "source_row_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "teamAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teams",
        "primary_team",
        "team_status",
        "source_season"
      ],
      "properties": {
        "teams": {
          "$ref": "#/$defs/stringArray"
        },
        "primary_team": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "team_status": {
          "enum": [
            "source_backed_historical_team",
            "source_backed_2026_drafted_team",
            "source_backed_2026_udfa_team",
            "source_explicit_free_agent",
            "source_explicit_unsigned",
            "source_unknown"
          ]
        },
        "source_season": {
          "enum": [
            2025,
            2026
          ]
        }
      }
    },
    "provenanceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_field",
        "value_status",
        "source_type",
        "source_name",
        "source_url",
        "observed_at",
        "source_updated_at",
        "last_verified_at",
        "confidence",
        "confidence_band",
        "notes"
      ],
      "properties": {
        "evidence_field": {
          "type": "string",
          "minLength": 1
        },
        "value_status": {
          "enum": [
            "present",
            "unavailable"
          ]
        },
        "source_type": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "source_name": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "source_url": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "observed_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_updated_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence_band": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "notes": {
          "$ref": "#/$defs/nullableNonEmptyString"
        }
      }
    },
    "availabilityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_artifact_generated_at",
        "provenance_records",
        "has_unresolved_timestamp"
      ],
      "properties": {
        "source_artifact_generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenanceRecord"
          }
        },
        "has_unresolved_timestamp": {
          "type": "boolean"
        }
      }
    },
    "populationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_row_id",
        "population_kind",
        "source_identity_ref",
        "canonical_player_id",
        "identity_status",
        "player_name",
        "position",
        "position_status",
        "history_status",
        "team_assignment",
        "availability_evidence"
      ],
      "properties": {
        "population_row_id": {
          "type": "string",
          "pattern": "^pop2026v0-[0-9a-f]{32}$"
        },
        "population_kind": {
          "enum": [
            "historical_offense_2025",
            "rookie_transition_2026"
          ]
        },
        "source_identity_ref": {
          "$ref": "#/$defs/sourceIdentityRef"
        },
        "canonical_player_id": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "identity_status": {
          "enum": [
            "canonical_id_source_verified",
            "canonical_id_duplicate_conflict",
            "source_id_present_canonical_unresolved",
            "source_id_missing_canonical_unresolved"
          ]
        },
        "player_name": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "position": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "position_status": {
          "enum": [
            "source_declared_bounded_offense_position",
            "source_declared_outside_bounded_offense_position",
            "source_position_missing"
          ]
        },
        "history_status": {
          "enum": [
            "source_backed_2025_player_season",
            "history_unresolved_no_exact_crosswalk"
          ]
        },
        "team_assignment": {
          "$ref": "#/$defs/teamAssignment"
        },
        "availability_evidence": {
          "$ref": "#/$defs/availabilityEvidence"
        }
      }
    },
    "coverageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_source",
        "by_population_kind",
        "by_identity_status",
        "by_position_status",
        "by_team_status",
        "by_history_status"
      ],
      "properties": {
        "by_source": {
          "$ref": "#/$defs/countMap"
        },
        "by_population_kind": {
          "$ref": "#/$defs/countMap"
        },
        "by_identity_status": {
          "$ref": "#/$defs/countMap"
        },
        "by_position_status": {
          "$ref": "#/$defs/countMap"
        },
        "by_team_status": {
          "$ref": "#/$defs/countMap"
        },
        "by_history_status": {
          "$ref": "#/$defs/countMap"
        }
      }
    },
    "identityLedgerRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_row_id",
        "source_artifact_key",
        "source_player_id",
        "identity_status"
      ],
      "properties": {
        "population_row_id": {
          "type": "string",
          "pattern": "^pop2026v0-[0-9a-f]{32}$"
        },
        "source_artifact_key": {
          "type": "string",
          "minLength": 1
        },
        "source_player_id": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "identity_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duplicate_source_ids",
        "duplicate_resolved_canonical_ids",
        "unresolved_identity_rows",
        "missing_identity_rows",
        "cross_source_canonical_identity_reconciliation",
        "cross_source_source_id_reuse",
        "duplicate_source_row_hashes",
        "counts"
      ],
      "properties": {
        "duplicate_source_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_artifact_key",
              "source_player_id",
              "population_row_ids"
            ],
            "properties": {
              "source_artifact_key": {
                "type": "string",
                "minLength": 1
              },
              "source_player_id": {
                "type": "string",
                "minLength": 1
              },
              "population_row_ids": {
                "$ref": "#/$defs/nonEmptyStringArray"
              }
            }
          }
        },
        "duplicate_resolved_canonical_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonical_player_id",
              "population_row_ids"
            ],
            "properties": {
              "canonical_player_id": {
                "type": "string",
                "minLength": 1
              },
              "population_row_ids": {
                "$ref": "#/$defs/nonEmptyStringArray"
              }
            }
          }
        },
        "unresolved_identity_rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identityLedgerRow"
          }
        },
        "missing_identity_rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identityLedgerRow"
          }
        },
        "cross_source_canonical_identity_reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "collision_groups",
            "items",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "unevaluable_no_exact_cross_namespace_contract"
            },
            "collision_groups": {
              "type": "null"
            },
            "items": {
              "type": "array",
              "maxItems": 0
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "cross_source_source_id_reuse": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_identity_value",
              "source_artifact_keys",
              "population_row_ids"
            ],
            "properties": {
              "source_identity_value": {
                "type": "string",
                "minLength": 1
              },
              "source_artifact_keys": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "population_row_ids": {
                "$ref": "#/$defs/nonEmptyStringArray"
              }
            }
          }
        },
        "duplicate_source_row_hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_artifact_key",
              "source_row_sha256",
              "population_row_ids"
            ],
            "properties": {
              "source_artifact_key": {
                "type": "string",
                "minLength": 1
              },
              "source_row_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "population_row_ids": {
                "$ref": "#/$defs/nonEmptyStringArray"
              }
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duplicate_source_id_groups",
            "duplicate_resolved_canonical_id_groups",
            "unresolved_identity_rows",
            "missing_identity_rows",
            "cross_source_canonical_identity_collision_groups",
            "cross_source_source_id_reuse_groups",
            "duplicate_source_row_hash_groups"
          ],
          "properties": {
            "duplicate_source_id_groups": {
              "type": "integer",
              "minimum": 0
            },
            "duplicate_resolved_canonical_id_groups": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved_identity_rows": {
              "type": "integer",
              "minimum": 0
            },
            "missing_identity_rows": {
              "type": "integer",
              "minimum": 0
            },
            "cross_source_canonical_identity_collision_groups": {
              "type": "null"
            },
            "cross_source_source_id_reuse_groups": {
              "type": "integer",
              "minimum": 0
            },
            "duplicate_source_row_hash_groups": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
