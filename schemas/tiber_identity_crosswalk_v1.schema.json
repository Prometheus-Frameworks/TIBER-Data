{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.tiber.local/schemas/tiber_identity_crosswalk_v1.schema.json",
  "title": "TIBER Identity Crosswalk V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "schema_version",
    "generated_at",
    "supported_providers",
    "coverage",
    "record_count",
    "records"
  ],
  "properties": {
    "artifact_id": { "const": "TIBER_IDENTITY_CROSSWALK_V1" },
    "schema_version": { "const": "v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "supported_providers": {
      "type": "array",
      "items": { "const": "sleeper" },
      "minItems": 1,
      "uniqueItems": true
    },
    "coverage": {
      "const": "seeded_operator_verified_mappings_only_not_full_player_universe"
    },
    "record_count": { "type": "integer", "minimum": 1 },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/crosswalkRow" }
    }
  },
  "$defs": {
    "crosswalkRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "provider_player_id",
        "provider_canonical_id",
        "tiber_player_id",
        "player_name",
        "position",
        "team",
        "confidence",
        "match_method",
        "source",
        "source_updated_at"
      ],
      "properties": {
        "provider": { "const": "sleeper" },
        "provider_player_id": { "type": "string", "minLength": 1 },
        "provider_canonical_id": {
          "type": "string",
          "pattern": "^sleeper:[^\\s:]+$"
        },
        "tiber_player_id": {
          "type": "string",
          "pattern": "^tiber-data-player-2025-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "player_name": { "type": "string", "minLength": 1 },
        "position": { "enum": ["QB", "RB", "WR", "TE", "K", "DST"] },
        "team": { "type": "string", "minLength": 2, "maxLength": 4 },
        "confidence": { "enum": ["exact", "high", "provisional"] },
        "match_method": { "enum": ["verified_manual_seed"] },
        "source": { "type": "string", "minLength": 1 },
        "source_updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
