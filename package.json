{
  "name": "tiber-data-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical role-opportunity data contracts for TIBER downstream repositories.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node web/server.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "export:forge-weekly-sample": "npm run build && node scripts/export_forge_weekly_input_sample.mjs",
    "export:forge-weekly-derived": "npm run build && node scripts/export_forge_weekly_input_derived.mjs",
    "export:forge-weekly-derived-upstream-scaffold": "npm run build && node scripts/export_forge_weekly_input_derived_upstream_scaffold.mjs",
    "export:player-weekly-ppr-outcomes-v1": "npm run build && node scripts/export_player_weekly_ppr_outcomes_v1.mjs",
    "export:player-weekly-usage-v1": "npm run build && node scripts/export_player_weekly_usage_v1.mjs",
    "export:historical-rookie-replay-v0": "npm run build && node scripts/export_historical_rookie_replay_v0.mjs",
    "export:team-pace-pass-environment-v1": "npm run build && node scripts/export_team_pace_pass_environment_v1.mjs",
    "export:team-offense-summary-v1": "npm run build && node scripts/export_team_offense_summary_v1.mjs",
    "export:roster-player-team-map-v1": "npm run build && node scripts/export_roster_player_team_map_v1.mjs",
    "export:historical-rookie-replay-readiness-v0": "npm run build && node scripts/export_historical_rookie_replay_readiness_v0.mjs",
    "export:player-weekly-ppr-source-backed-2025": "npm run build && node scripts/export_player_weekly_ppr_outcomes_source_backed_2025.mjs",
    "inspect:goblin-room": "node scripts/inspect_goblin_room.mjs",
    "build:play-caller-proe": "node scripts/build_play_caller_pass_rate_over_expectation.mjs",
    "build:receiving-role-integrity-proxy": "node scripts/build_receiving_role_integrity_proxy.mjs",
    "inspect:projection-input-semantics": "node scripts/inspect_projection_input_semantics.mjs",
    "docs:projection-input-semantics": "node scripts/inspect_projection_input_semantics.mjs --write",
    "check:point-prediction-scenario-export": "node scripts/check_point_prediction_scenario_export_contract.mjs",
    "check:player-lab": "node scripts/check_player_lab_route.mjs",
    "check:rb-contact-evasion-bundle": "python3 scripts/validate_rb_contact_evasion_bundle.py"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
