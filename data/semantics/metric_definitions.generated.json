        "status": "unresolved",
        "rule": "Silver sums input player targets by team/season/week; event eligibility and full population are not established by the formula."
      },
      "aggregation": {
        "status": "not_selected",
        "rule": "No rolling/season aggregation is selected; ratio of summed matched counts and mean of game ratios answer different questions."
      },
      "missing_behavior": "Legacy gold code returns 0.0 when team_targets is null, zero or negative. This inspection does not repair that behavior.",
